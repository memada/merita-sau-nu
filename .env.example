# Development: copy to .env.local. Production: .env on the droplet.
APP_URL=http://localhost:3002
DATABASE_URL=file:./data/leads.sqlite
ADMIN_USERNAME=
# npm run admin:hash (interactive, password never in command history)
ADMIN_PASSWORD_HASH=
# openssl rand -hex 32 — required for sessions, rate limit and IP pseudonymization
SESSION_SECRET=
# Enable only when direct access to the origin is blocked and CF Tunnel is the entrypoint.
TRUST_CF_HEADERS=false
OPERATOR_NAME=
OPERATOR_ADDRESS=
PRIVACY_EMAIL=
# Complete actual recipient categories / suppliers before accepting real requests.
SUPPLIER_DISCLOSURE=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# CI / Compose
DOCR_IMAGE=
HOST_PORT=3002
