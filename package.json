{
  "name": "merita-sau-nu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "next": "16.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "24.12.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.8.3"
  }
}
